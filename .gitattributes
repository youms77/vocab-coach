# Normalise line endings in the repository; check out with the platform default.
* text=auto

# Shell scripts must keep LF to run on macOS/Linux.
*.sh text eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.webm binary
*.wav binary
*.mp3 binary

# Word lists are redistributed byte for byte (CC BY-SA 4.0, "files unchanged").
content/wordlists/*.csv -text
